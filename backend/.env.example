# Copy to .env and fill in:  cp .env.example .env

# MySQL (use an IP if the hostname doesn't resolve inside Docker)
DB_HOST=homeserver
DB_USER=yorapet_api
DB_PASSWORD=change-me
DB_NAME=yorapet3

# Login token signing key. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me

# API container port (nginx proxies to it; only exposed on 127.0.0.1)
API_PORT=8009
API_WORKERS=2

# Public domain served by nginx (DNS A record must point to this server)
DOMAIN=yorapetapi.yoratech.com
# Email for Let's Encrypt expiry notices
CERTBOT_EMAIL=you@example.com
