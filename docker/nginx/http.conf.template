server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt domain validation
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Switched to a redirect to HTTPS once a certificate exists (see 40-enable-https.sh)
    include /etc/nginx/conf.d/http-main.inc;
}
