# Copy to .env and fill in:  cp .env.example .env

# MySQL (use an IP if the hostname doesn't resolve inside Docker)
DB_HOST=homeserver
DB_USER=yorapet_api
DB_PASSWORD=change-me
DB_NAME=yorapet3

# Login token signing key. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me

# API port (bound to 127.0.0.1 only; nginx proxies to it)
API_PORT=8009
API_WORKERS=2

# Public domain for the nginx site (DNS A record must point to this server)
DOMAIN=yorapetapi.yoratech.com
